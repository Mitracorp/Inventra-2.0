## Ignore technician signature images but keep the folder
backend/uploads/signature-staff/**
!backend/uploads/signature-staff/.gitkeep
node_modules

# Environment variables (real secrets – never commit these)
.env.production
backend/.env
backend/.env.production
frontend/.env
frontend/.env.production
frontend/.env.development
# backend/.env.example is intentionally NOT ignored – it is a safe template

# Ignore backend runtime logs (keep .gitkeep so the dir is tracked)
backend/logs/*
!backend/logs/.gitkeep
*.log

# Ignore generated PM report PDFs (each user generates their own)
backend/uploads/pm-reports/*.pdf

# Ignore signed PM reports
backend/uploads/signed-pm-reports/*
!backend/uploads/signed-pm-reports/.gitkeep

# Ignore user signature images
backend/uploads/signature/*.png

# OS files
.DS_Store
Thumbs.db
