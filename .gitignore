## Ignore technician signature images but keep the folder
backend/uploads/signature-staff/**
!backend/uploads/signature-staff/.gitkeep
node_modules

# Environment variables
.env.production
backend/.env
backend/.env.example
backend/.env.production
frontend/.env
frontend/.env.production
frontend/.env.development

# Ignore backend runtime logs
backend/logs/
*.log

# Ignore generated PM report PDFs (each user generates their own)
backend/uploads/pm-reports/*.pdf
backend/uploads/bulkpm-reports/*.pdf

# Ignore generated UAT report artifacts
backend/uploads/uat-reports/*.pdf
backend/uploads/uat-reports/verification-registry.json

# Ignore signed PM reports
backend/uploads/signed-pm-reports/*
!backend/uploads/signed-pm-reports/.gitkeep

# Ignore generated project logo uploads (keep curated static logos)
backend/uploads/project-logo/project_*.png
backend/uploads/project-logo/project_*.jpg
backend/uploads/project-logo/project_*.jpeg
backend/uploads/project-logo/project_*.webp

# Ignore user signature images
backend/uploads/signature/*.png

# OS files
.DS_Store
Thumbs.db
