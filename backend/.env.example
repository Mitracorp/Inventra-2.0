# ──────────────────────────────────────────────────────────────────────────────
# Inventra Backend – Production Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# INSTRUCTIONS
#   1. Copy this file to  backend/.env  on the production/staging server.
#   2. Fill in EVERY value marked <REQUIRED>.
#   3. Never commit the real .env file – it is listed in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── MySQL / MariaDB Database ──────────────────────────────────────────────────
# These values come from cPanel → MySQL Databases.
# Add the server's IP to cPanel → Remote MySQL if the app runs on a remote host.
DB_HOST=localhost
DB_PORT=3306
DB_USER=<REQUIRED>           # e.g. ivms2006_inventra
DB_PASSWORD=<REQUIRED>       # strong password set in cPanel MySQL
DB_NAME=<REQUIRED>           # e.g. ivms2006_inventra_db

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=<REQUIRED>        # long random string – generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_EXPIRES_IN=24h

# ── CORS ──────────────────────────────────────────────────────────────────────
# The public URL of the front-end (no trailing slash)
CORS_ORIGIN=https://inventra.ivms2006.com

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
